# You can find documentation for all the supported env variables at https://immich.app/docs/install/environment-variables

# The Immich version to use. You can pin this to a specific version like "v1.71.0"
IMMICH_VERSION=release

## file location: https://immich.app/docs/guides/custom-locations
UPLOAD_LOCATION=${PANEL_UPLOAD_LOCATION}
THUMB_LOCATION=${PANEL_THUMB_LOCATION}
ENCODED_VIDEO_LOCATION=${PANEL_ENCODED_VIDEO_LOCATION}
PROFILE_LOCATION=${PANEL_PROFILE_LOCATION}
BACKUP_LOCATION=${PANEL_BACKUP_LOCATION}

## https://immich.app/docs/install/config-file
#IMMICH_CONFIG_FILE=${PANEL_IMMICH_CONFIG_FILE}

CACHE_PATH=${PANEL_CACHE_PATH}
DATA_PATH=${PANEL_DB_PATH}


###################################################################################

## external database
DB_HOSTNAME=${PANEL_DB_HOST}
DB_PORT=${PANEL_DB_PORT:-5432}
DB_USERNAME=${PANEL_DB_USER:-immich}
DB_PASSWORD=${PANEL_DB_USER_PASSWORD:-immich_P@ssw0rd}
DB_DATABASE_NAME=${PANEL_DB_NAME:-immich}

## external redis
REDIS_HOSTNAME=${PANEL_REDIS_HOST:-redis}
REDIS_PORT=${PANEL_REDIS_PORT:-6379}
REDIS_USERNAME=${PANEL_REDIS_USER:-}
REDIS_PASSWORD=${PANEL_REDIS_PASSWORD:-redis_pass123}
REDIS_DBINDEX=1